<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSign"
                    style="@style/Dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Hồ sơ của tôi"
                android:gravity="center"
                android:text="👤"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="AI PALM READER"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Phân tích bàn tay"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Dim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Quét lòng bàn tay để đọc đường tâm đạo, trí đạo và sinh đạo." />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:text="🖐"
                    android:textSize="56sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnScan"
                style="@style/Cta"
                android:layout_marginTop="16dp"
                android:text="Quét ngay" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardDaily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Báo cáo hôm nay" />

            <TextView
                android:id="@+id/tvDaily"
                style="@style/Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp"
            android:text="Khám phá vận mệnh" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:id="@+id/tileHoroscope"
                style="@style/Tile"
                android:text="🔮\n\nTử vi hằng ngày" />

            <TextView
                android:id="@+id/tileTarot"
                style="@style/Tile"
                android:text="🃏\n\nBói bài Tarot" />

            <TextView
                android:id="@+id/tileLove"
                style="@style/Tile"
                android:text="💞\n\nTest tình duyên" />

            <TextView
                android:id="@+id/tileAstrology"
                style="@style/Tile"
                android:text="🪐\n\nChiêm tinh Vệ Đà" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
