<resources>
    <style name="Theme.PalmReader" parent="Theme.Material3.Dark">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- Android 15 ép tràn viền với targetSdk 35; layout XML đơn giản này không tự xử lý insets -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="colorPrimary">@color/grad_end</item>
        <item name="colorOnPrimary">@color/text</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="actionBarStyle">@style/PalmActionBar</item>
        <item name="materialCardViewStyle">@style/PalmCard</item>
    </style>

    <style name="Theme.PalmReader.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="PalmActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/bg</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="PalmCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <style name="Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- nút chính: gradient bo tròn như CTA của app gốc -->
    <style name="Cta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_cta</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ô tính năng ở trang chủ -->
    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:minHeight">112dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Dim">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
