<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/surface_high" />
            <stroke android:width="3dp" android:color="@color/stroke" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="0"
                        android:centerColor="@color/grad_mid"
                        android:endColor="@color/grad_end"
                        android:startColor="@color/grad_start" />
                    <stroke android:width="3dp" android:color="@color/text" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
